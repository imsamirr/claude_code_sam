# ===========================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ===========================================

# --- TripleWhale ---
# Get this from: TripleWhale Dashboard > Settings > API
TRIPLEWHALE_API_KEY=your_triplewhale_api_key_here

# --- Shopify ---
# Get these from: Shopify Admin > Settings > Apps > Develop apps
SHOPIFY_STORE_URL=your-store-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here

# --- Google Sheets ---
# Path to the Google service account JSON key file
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
# The full URL of your Google Sheet (or just the spreadsheet ID)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# The name of the worksheet/tab to write data to
GOOGLE_SHEET_TAB_NAME=Daily Metrics
