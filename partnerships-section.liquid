{%- comment -%}
  ============================================================================
  Section: Partnerships
  ----------------------------------------------------------------------------
  A partnership landing layout modelled on
  zimadental.com/pages/partnerships, rebuilt natively for the Horizon theme.

  Structure:
    1. Heading + subtitle
    2. A responsive grid of "option" cards (icon, title, blurb).
       Each card shows a chosen icon and can optionally link somewhere
       (a contact page, an anchor to your own Contact Form section, a
       mailto, etc.). Leave the link blank to render a plain card.
    3. A support note with a button.

  Note: this version has NO built-in form and NO images - add your own
  Contact Form section on the page below it. Card visuals use inline SVG
  icons picked per card in the theme editor.

  Install:
    Online Store > Themes > ... > Edit code > Sections > Add a new section,
    name it "partnerships", paste this whole file, Save. Then add the
    "Partnerships" section to a page template in the theme editor.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign columns = section.settings.columns_desktop | default: 4
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .pp-section {
    --pp-columns: {{ columns }};
    --pp-columns-tablet: {{ section.settings.columns_tablet }};
    --pp-gap: {{ section.settings.card_gap }}px;
    --pp-radius: {{ section.settings.card_corner_radius }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} pp-wrapper">
  <div class="pp-section page-width">
    {%- if section.settings.heading != blank -%}
      <div class="pp-header">
        <h1 class="pp-header__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <div class="pp-header__subtitle rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pp-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'option' -%}
            {%- assign has_link = false -%}
            {%- if block.settings.link != blank -%}
              {%- assign has_link = true -%}
            {%- endif -%}

            <a
              class="pp-card{% unless has_link %} pp-card--static{% endunless %}"
              {% if has_link %}href="{{ block.settings.link }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="pp-card__body">
                <span class="pp-card__icon">
                  {%- case block.settings.icon -%}
                    {%- when 'tooth' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5.5c-1.5-1.6-4-2-5.8-1C4 5.6 3.5 8 4.2 10.4c.5 1.7.7 2.3.9 4 .2 1.7.3 3.6 1.6 3.6 1.2 0 1.3-1.6 1.6-3 .3-1.3.6-2 1.7-2s1.4.7 1.7 2c.3 1.4.4 3 1.6 3 1.3 0 1.4-1.9 1.6-3.6.2-1.7.4-2.3.9-4C18.5 8 18 5.6 15.8 4.5 14 3.5 11.5 3.9 10 5.5"/></svg>
                    {%- when 'camera' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h2l1.2-1.8A1 1 0 0 1 8.5 4.7h7a1 1 0 0 1 .8.5L17.5 7h2A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z"/><circle cx="12" cy="12.5" r="3.2"/></svg>
                    {%- when 'store' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5 5 5h14l1 4.5M4 9.5h16M4 9.5v9A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5v-9M4 9.5a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0M9.5 20v-5h5v5"/></svg>
                    {%- when 'handshake' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m8 12 2.2 2.2a1 1 0 0 0 1.4 0l.9-.9 2.4 2.3a1.2 1.2 0 0 0 1.7-1.7l-.5-.5.6.5a1.2 1.2 0 0 0 1.7-1.7l-.7-.7.2.2a1.2 1.2 0 0 0 1.7-1.7L17 5.6a2 2 0 0 0-1.8-.6l-3 .6-2-1a2 2 0 0 0-1.6 0L4 6.5M4 6.5 2.5 13M20 7l1.5 6"/></svg>
                    {%- when 'envelope' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z"/><path d="M3.5 6.5 12 12.5 20.5 6.5"/></svg>
                    {%- when 'megaphone' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6l-6 4H4z"/><path d="M16 9a4 4 0 0 1 0 6"/></svg>
                    {%- when 'users' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><path d="M15.5 5.7a3 3 0 0 1 0 5.6"/><path d="M21 19a5.5 5.5 0 0 0-4-5.3"/></svg>
                    {%- when 'briefcase' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5A1.5 1.5 0 0 1 4.5 7h15A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z"/><path d="M8.5 7V5.5A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5V7"/><path d="M3 12.5h18"/></svg>
                    {%- when 'globe' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.5 2.4 2.5 14.6 0 17M12 3.5c-2.5 2.4-2.5 14.6 0 17"/></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4l2.3 4.9 5.4.6-4 3.7 1.1 5.3L12 16.9 7.2 18.5 8.3 13.2 4.3 9.5l5.4-.6z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 8v4l3 2"/></svg>
                  {%- endcase -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <h3 class="pp-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="pp-card__desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if has_link and section.settings.card_cta_label != blank -%}
                  <span class="pp-card__cta" aria-hidden="true">
                    {{ section.settings.card_cta_label }}
                    <svg class="pp-card__arrow" viewBox="0 0 16 16" fill="none" width="15" height="15">
                      <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- Support note ---------- {%- endcomment -%}
    {%- if section.settings.support_text != blank -%}
      <div class="pp-support">
        <p class="pp-support__text">{{ section.settings.support_text }}</p>
        {%- if section.settings.support_button_label != blank and section.settings.support_button_link != blank -%}
          <a class="pp-support__btn" href="{{ section.settings.support_button_link }}">
            {{ section.settings.support_button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .pp-section {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 2rem;
    box-sizing: border-box;
  }

  /* ---------- Header ---------- */
  .pp-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }
  .pp-header__title {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pp-header__subtitle {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  /* ---------- Grid of option cards ---------- */
  .pp-grid {
    display: grid;
    grid-template-columns: repeat(var(--pp-columns, 4), minmax(0, 1fr));
    gap: var(--pp-gap, 24px);
  }
  .pp-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.02);
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.08);
    border-radius: var(--pp-radius, 16px);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }
  .pp-card--static {
    cursor: default;
  }
  .pp-card:not(.pp-card--static):hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.1);
    border-color: rgba(var(--color-foreground, 18, 18, 18), 0.16);
  }
  .pp-card__body {
    padding: 1.6rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1 1 auto;
  }
  .pp-card__icon {
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    border-radius: 14px;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.06);
    color: rgb(var(--color-foreground, 18, 18, 18));
  }
  .pp-card__icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }
  .pp-card__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .pp-card__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    opacity: 0.7;
  }
  .pp-card__cta {
    margin-top: auto;
    padding-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .pp-card__arrow {
    transition: transform 0.2s ease;
  }
  .pp-card:not(.pp-card--static):hover .pp-card__arrow {
    transform: translateX(3px);
  }

  /* ---------- Support note ---------- */
  .pp-support {
    margin-top: 3.5rem;
    text-align: center;
  }
  .pp-support__text {
    margin: 0 0 1rem;
    opacity: 0.75;
  }
  .pp-support__btn {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.3);
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pp-support__btn:hover {
    background: rgb(var(--color-foreground, 18, 18, 18));
    color: rgb(var(--color-background, 255, 255, 255));
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 989px) {
    .pp-grid {
      grid-template-columns: repeat(var(--pp-columns-tablet, 2), minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .pp-section {
      padding-inline: 1.25rem;
    }
    .pp-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Partnerships",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partnerships"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Click the option below that is most suited to your partnership opportunity to get in contact with the relevant team.</p>"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card link label",
      "info": "Only shows on cards that have a link set.",
      "default": "Get in touch"
    },
    {
      "type": "header",
      "content": "Support note"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>If you would like to speak to customer service, please visit our support page.</p>"
    },
    {
      "type": "text",
      "id": "support_button_label",
      "label": "Support button label",
      "default": "Support"
    },
    {
      "type": "url",
      "id": "support_button_link",
      "label": "Support button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Partnership option",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tooth", "label": "Tooth" },
            { "value": "camera", "label": "Camera" },
            { "value": "store", "label": "Storefront" },
            { "value": "handshake", "label": "Handshake" },
            { "value": "envelope", "label": "Envelope" },
            { "value": "megaphone", "label": "Megaphone" },
            { "value": "users", "label": "People" },
            { "value": "briefcase", "label": "Briefcase" },
            { "value": "globe", "label": "Globe" },
            { "value": "star", "label": "Star" }
          ],
          "default": "handshake"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Partnership option"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description of this partnership type."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Where the card goes when clicked. Leave blank for a plain display card. Tip: link to your Contact Form section using an anchor like #contact."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Partnerships",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "icon": "tooth",
            "title": "I'm a Dental Professional",
            "description": "Wholesale, demonstration units, customisations."
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "camera",
            "title": "I'm a Content Creator",
            "description": "Demonstration units, content collaboration and influencer."
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "store",
            "title": "I work for a Retailer",
            "description": "Online and in-store retail."
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "handshake",
            "title": "Other Partnership",
            "description": "PR or other partnerships."
          }
        }
      ]
    }
  ]
}
{% endschema %}
