{%- comment -%}
  ============================================================================
  Section: Partnerships
  ----------------------------------------------------------------------------
  A partnership landing layout modelled on
  zimadental.com/pages/partnerships, rebuilt natively for the Horizon theme.

  Structure:
    1. Heading + subtitle
    2. A responsive grid of "option" cards (image, title, blurb).
       Each card can optionally link somewhere (a contact page, an anchor
       to your own Contact Form section, a mailto, etc.). Leave the link
       blank to render a plain, non-clickable card.
    3. A support note with a button.

  Note: this version has NO built-in form — add your own Contact Form
  section on the page below it.

  Install:
    Online Store > Themes > ... > Edit code > Sections > Add a new section,
    name it "partnerships", paste this whole file, Save. Then add the
    "Partnerships" section to a page template in the theme editor.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign columns = section.settings.columns_desktop | default: 4
-%}

<div class="color-{{ section.settings.color_scheme }} pp-wrapper">
  <div
    class="pp-section page-width"
    style="
      --pp-columns: {{ columns }};
      --pp-columns-tablet: {{ section.settings.columns_tablet }};
      --pp-gap: {{ section.settings.card_gap }}px;
      --pp-radius: {{ section.settings.card_corner_radius }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <div class="pp-header">
        <h1 class="pp-header__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <div class="pp-header__subtitle rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pp-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'option' -%}
            {%- assign has_link = false -%}
            {%- if block.settings.link != blank -%}
              {%- assign has_link = true -%}
            {%- endif -%}

            {%- if has_link -%}
              <a href="{{ block.settings.link }}" class="pp-card" {{ block.shopify_attributes }}>
            {%- else -%}
              <div class="pp-card pp-card--static" {{ block.shopify_attributes }}>
            {%- endif -%}

              <div class="pp-card__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 600, 800',
                      sizes: '(min-width: 750px) 25vw, 90vw',
                      class: 'pp-card__img',
                      alt: block.settings.title
                  }}
                {%- else -%}
                  <div class="pp-card__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'pp-card__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              <div class="pp-card__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="pp-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="pp-card__desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if has_link and section.settings.card_cta_label != blank -%}
                  <span class="pp-card__cta" aria-hidden="true">
                    {{ section.settings.card_cta_label }}
                    <svg class="pp-card__arrow" viewBox="0 0 16 16" fill="none" width="15" height="15">
                      <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- Support note ---------- {%- endcomment -%}
    {%- if section.settings.support_text != blank -%}
      <div class="pp-support">
        <p class="pp-support__text">{{ section.settings.support_text }}</p>
        {%- if section.settings.support_button_label != blank and section.settings.support_button_link != blank -%}
          <a class="pp-support__btn" href="{{ section.settings.support_button_link }}">
            {{ section.settings.support_button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .pp-section {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 2rem;
    box-sizing: border-box;
  }

  /* ---------- Header ---------- */
  .pp-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }
  .pp-header__title {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .pp-header__subtitle {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    opacity: 0.75;
  }

  /* ---------- Grid of option cards ---------- */
  .pp-grid {
    display: grid;
    grid-template-columns: repeat(var(--pp-columns, 4), minmax(0, 1fr));
    gap: var(--pp-gap, 24px);
  }
  .pp-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.02);
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.08);
    border-radius: var(--pp-radius, 16px);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
  }
  a.pp-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.1);
    border-color: rgba(var(--color-foreground, 18, 18, 18), 0.16);
  }
  .pp-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgba(var(--color-foreground, 18, 18, 18), 0.04);
  }
  .pp-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  a.pp-card:hover .pp-card__img {
    transform: scale(1.04);
  }
  .pp-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pp-card__placeholder-svg {
    width: 42%;
    opacity: 0.35;
  }
  .pp-card__body {
    padding: 1.25rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1 1 auto;
  }
  .pp-card__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .pp-card__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    opacity: 0.7;
  }
  .pp-card__cta {
    margin-top: auto;
    padding-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .pp-card__arrow {
    transition: transform 0.2s ease;
  }
  a.pp-card:hover .pp-card__arrow {
    transform: translateX(3px);
  }

  /* ---------- Support note ---------- */
  .pp-support {
    margin-top: 3.5rem;
    text-align: center;
  }
  .pp-support__text {
    margin: 0 0 1rem;
    opacity: 0.75;
  }
  .pp-support__btn {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.3);
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .pp-support__btn:hover {
    background: rgb(var(--color-foreground, 18, 18, 18));
    color: rgb(var(--color-background, 255, 255, 255));
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 989px) {
    .pp-grid {
      grid-template-columns: repeat(var(--pp-columns-tablet, 2), minmax(0, 1fr));
    }
  }
  @media screen and (max-width: 749px) {
    .pp-section {
      padding-inline: 1.25rem;
    }
    .pp-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Partnerships",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partnerships"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Click the option below that is most suited to your partnership opportunity to get in contact with the relevant team.</p>"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card link label",
      "info": "Only shows on cards that have a link set.",
      "default": "Get in touch"
    },
    {
      "type": "header",
      "content": "Support note"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>If you would like to speak to customer service, please visit our support page.</p>"
    },
    {
      "type": "text",
      "id": "support_button_label",
      "label": "Support button label",
      "default": "Support"
    },
    {
      "type": "url",
      "id": "support_button_link",
      "label": "Support button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Partnership option",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Partnership option"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Short description of this partnership type."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Where the card goes when clicked. Leave blank for a plain display card. Tip: link to your Contact Form section using an anchor like #contact."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Partnerships",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "title": "I'm a Dental Professional",
            "description": "Wholesale, demonstration units, customisations."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "I'm a Content Creator",
            "description": "Demonstration units, content collaboration and influencer."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "I work for a Retailer",
            "description": "Online and in-store retail."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Other Partnership",
            "description": "PR or other partnerships."
          }
        }
      ]
    }
  ]
}
{% endschema %}
