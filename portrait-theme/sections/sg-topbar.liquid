{%- liquid
  assign is_simple = false
  if section.settings.hide_on_pages
    if template.name == 'page' or request.page_type == 'policy'
      assign is_simple = true
    endif
  endif
-%}
{%- unless is_simple -%}
  {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
  {%- if tab_blocks.size > 0 -%}
    <nav class="sg-tabs" aria-label="{{ section.settings.tabs_label | escape }}">
      <ul class="sg-tabs__list" role="list">
        {%- for block in tab_blocks -%}
          {%- liquid
            assign is_current = false
            if block.settings.link == request.path
              assign is_current = true
            elsif block.settings.match_handle != blank and product and product.handle == block.settings.match_handle
              assign is_current = true
            endif
          -%}
          <li class="sg-tabs__item" {{ block.shopify_attributes }}>
            <a
              class="sg-tabs__link"
              href="{{ block.settings.link | default: '#' }}"
              {% if is_current %}
                aria-current="page"
              {% endif %}
            >
              {%- if block.settings.icon != 'none' -%}
                {% render 'sg-icon', name: block.settings.icon %}
              {%- endif -%}
              {{ block.settings.label }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- if section.settings.subbar_text != blank or section.settings.subbar_link_label != blank -%}
    <div class="sg-subbar">
      <div class="sg-subbar__inner">
        {%- if section.settings.subbar_text != blank -%}
          <span>{{ section.settings.subbar_text }}</span>
        {%- endif -%}
        {%- if section.settings.subbar_link_label != blank -%}
          <a href="{{ section.settings.subbar_link | default: routes.account_url }}">
            {%- render 'sg-icon', name: 'package' -%}
            {{- section.settings.subbar_link_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product tabs & sub bar",
  "class": "sg-topbar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_on_pages",
      "label": "Hide on content pages",
      "info": "Pages like Shipping, Contact and policies use a minimal header.",
      "default": true
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs accessibility label",
      "default": "Product types"
    },
    {
      "type": "header",
      "content": "Sub bar"
    },
    {
      "type": "text",
      "id": "subbar_text",
      "label": "Text",
      "default": "Free Preview · Pay Only If You Love It"
    },
    {
      "type": "text",
      "id": "subbar_link_label",
      "label": "Link label",
      "default": "Track My Order"
    },
    {
      "type": "url",
      "id": "subbar_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Prints"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "frame",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "frame", "label": "Frame" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkles", "label": "Sparkles" }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "match_handle",
          "label": "Also highlight on product (handle)",
          "info": "Optional. Highlights this tab when viewing this product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs & sub bar"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
