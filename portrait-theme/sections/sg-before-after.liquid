<section class="sg-section sg-ba" id="{{ section.settings.anchor | default: 'examples' }}">
  <div class="sg-container">
    <div class="sg-section__head sg-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="sg-h2 sg-h2--500">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="sg-lead">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="sg-ba__grid">
      {%- for block in section.blocks -%}
        <div class="sg-compare sg-reveal" data-sg-compare {{ block.shopify_attributes }}>
          <div class="sg-compare__img sg-compare__img--after">
            {%- if block.settings.after != blank -%}
              {{ block.settings.after | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 640px) 376px, 100vw', alt: block.settings.after_alt }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'sg-ph' }}
            {%- endif -%}
          </div>
          <div class="sg-compare__img sg-compare__img--before">
            {%- if block.settings.before != blank -%}
              {{ block.settings.before | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 640px) 376px, 100vw', alt: block.settings.before_alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'sg-ph' }}
            {%- endif -%}
          </div>
          <span class="sg-compare__label sg-compare__label--before">{{ section.settings.before_label }}</span>
          <span class="sg-compare__label sg-compare__label--after">{{ section.settings.after_label }}</span>
          <span class="sg-compare__line"></span>
          <span class="sg-compare__handle">{% render 'sg-icon', name: 'compare' %}</span>
          <input
            class="sg-compare__range"
            type="range"
            min="0"
            max="100"
            value="{{ section.settings.start }}"
            aria-label="{{ section.settings.before_label }} / {{ section.settings.after_label }}"
          >
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="sg-ba__caption">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Before / after",
  "class": "sg-ba-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the Magic" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Four real Warm transformations" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After" },
    { "type": "range", "id": "start", "label": "Slider start position", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Drag the slider to reveal each transformation." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "examples", "info": "Link to this section with /#examples" }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Comparison",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "before", "label": "Before image" },
        { "type": "text", "id": "before_alt", "label": "Before alt text", "default": "Original photo" },
        { "type": "image_picker", "id": "after", "label": "After image" },
        { "type": "text", "id": "after_alt", "label": "After alt text", "default": "Finished portrait" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before / after",
      "blocks": [{ "type": "pair" }, { "type": "pair" }, { "type": "pair" }, { "type": "pair" }]
    }
  ]
}
{% endschema %}
