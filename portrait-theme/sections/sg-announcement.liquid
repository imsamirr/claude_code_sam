{%- if section.settings.text != blank -%}
  <div class="sg-announcement" style="background: {{ section.settings.bg }}; color: {{ section.settings.color }};" {{ section.shopify_attributes }}>
    <div class="sg-announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "sg-announcement-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Sitewide sale | 30% off everything"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#3F2D6B"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#FFFCF7"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
