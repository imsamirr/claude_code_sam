<section class="sg-section sg-showcase">
  <div class="sg-container">
    <div class="sg-section__head sg-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="sg-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="sg-lead sg-lead--lg">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="sg-showcase__media sg-reveal">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '760x' }}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 760 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'sg-ph' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video showcase",
  "class": "sg-showcase-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See It in the Light" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real glass, a gold rim and a chain — turned in the hand so you can see it move." },
    { "type": "video", "id": "video", "label": "Video (vertical)" },
    { "type": "image_picker", "id": "image", "label": "Image (used if no video)" }
  ],
  "presets": [{ "name": "Video showcase" }]
}
{% endschema %}
