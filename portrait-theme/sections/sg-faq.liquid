<section class="sg-section sg-faq-section" id="{{ section.settings.anchor | default: 'faq' }}" style="padding-bottom: 64px;">
  <div class="sg-container">
    <div class="sg-faq">
      {%- if section.settings.heading != blank -%}
        <h2 class="sg-h2 sg-h2--sm" style="text-align:center;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="sg-faq__list">
        {%- for block in section.blocks -%}
          <details class="sg-faq__item" {{ block.shopify_attributes }}>
            <summary class="sg-faq__q">
              <span>{{ block.settings.question }}</span>
              {%- render 'sg-icon', name: 'chevron-down' -%}
            </summary>
            <div class="sg-faq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "sg-faq-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & Ordering Questions" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data (SEO)", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long until my order arrives?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
