<section class="wrap" aria-labelledby="g-{{ section.id }}">
  <div class="panel">
    <div class="g-grid">
      <div>
        {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
        <h2 id="g-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
        <p class="para clamp" id="gp-{{ section.id }}">{{ section.settings.text }}</p>
        <button class="more" type="button" data-for="gp-{{ section.id }}" aria-expanded="false" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label }} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4.5L6 7.5 9 4.5"/></svg></button>
        {%- endif -%}
        {%- if section.settings.image_left -%}<div class="g-prints"><div class="print a"><img src="{{ section.settings.image_left | image_url: width: 900 }}" alt="{{ section.settings.image_left.alt | escape }}" width="900" height="780" loading="lazy"></div></div>{%- endif -%}
      </div>
      <div class="g-right">
        {%- if section.settings.image_right -%}<div class="print"><img src="{{ section.settings.image_right | image_url: width: 900 }}" alt="{{ section.settings.image_right.alt | escape }}" width="900" height="780" loading="lazy"></div>{%- endif -%}
        <div class="g-rows">
          {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}><span class="ico">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
              {%- when 'headset' -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>
              {%- else -%}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18M10 14l-2 2 2 2M8 16h6a2 2 0 0 0 0-4h-1"/></svg>
            {%- endcase -%}
          </span><span><span class="serif">{{ block.settings.title }}</span><p>{{ block.settings.text }}</p></span></div>
          {%- endfor -%}
        </div>
        {%- if section.settings.button_label != blank %}<a class="cta light" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label }}</a>{% endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Retra-Shots guarantee",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take it on your travels, risk-free." },
    { "type": "textarea", "id": "text", "label": "Paragraph" },
    { "type": "text", "id": "more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "less_label", "label": "Read less label", "default": "Read less" },
    { "type": "image_picker", "id": "image_left", "label": "Print photo (left)" },
    { "type": "image_picker", "id": "image_right", "label": "Print photo (right)" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#buy" }
  ],
  "blocks": [ { "type": "row", "name": "Reassurance row", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "returns", "options": [ { "value": "returns", "label": "Returns" }, { "value": "truck", "label": "Delivery" }, { "value": "headset", "label": "Support" } ] },
    { "type": "text", "id": "title", "label": "Title", "default": "30-day field trial" },
    { "type": "inline_richtext", "id": "text", "label": "Text" }
  ] } ],
  "presets": [ { "name": "Retra-Shots guarantee" } ]
}
{% endschema %}
