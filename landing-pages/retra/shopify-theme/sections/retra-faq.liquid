<section class="sec faq-wrap" id="faq" aria-labelledby="faq-{{ section.id }}">
  <div class="collage l" aria-hidden="true">
    {%- for i in (1..3) -%}{%- assign key = 'collage_' | append: i -%}{%- assign img = section.settings[key] -%}
      {%- if img -%}<div class="print p{{ i }}"><img src="{{ img | image_url: width: 760 }}" alt="" width="380" height="380" loading="lazy"></div>{%- endif -%}
    {%- endfor -%}
  </div>
  <div class="collage r" aria-hidden="true">
    {%- for i in (4..6) -%}{%- assign key = 'collage_' | append: i -%}{%- assign img = section.settings[key] -%}
      {%- if img -%}<div class="print p{{ i }}"><img src="{{ img | image_url: width: 760 }}" alt="" width="380" height="380" loading="lazy"></div>{%- endif -%}
    {%- endfor -%}
  </div>
  <div class="wrap">
    <div class="head"><h2 id="faq-{{ section.id }}">{{ section.settings.heading }}</h2></div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary>{{ block.settings.answer }}</details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Retra-Shots FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "header", "content": "Photo collage (wide screens)" },
    { "type": "image_picker", "id": "collage_1", "label": "Left 1" },
    { "type": "image_picker", "id": "collage_2", "label": "Left 2" },
    { "type": "image_picker", "id": "collage_3", "label": "Left 3" },
    { "type": "image_picker", "id": "collage_4", "label": "Right 1" },
    { "type": "image_picker", "id": "collage_5", "label": "Right 2" },
    { "type": "image_picker", "id": "collage_6", "label": "Right 3" }
  ],
  "blocks": [ { "type": "question", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "Question" }, { "type": "richtext", "id": "answer", "label": "Answer" } ] } ],
  "presets": [ { "name": "Retra-Shots FAQ" } ]
}
{% endschema %}
