<section class="sec" id="reviews" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="rv-{{ section.id }}" data-rv>
  <div class="wrap">
    <div class="head rv-head">
      {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
      <h2 id="rv-{{ section.id }}">{% if section.settings.heading != blank %}<span class="l1m">{{ section.settings.heading }}</span>{% endif %}{{ section.settings.heading_2 }}</h2>
      {%- if section.settings.rating_text != blank -%}
      <div class="rating-line"><span class="sq" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span> <span>{{ section.settings.rating_text }}</span>{% if section.settings.sample_note != blank %} <span class="sample">{{ section.settings.sample_note }}</span>{% endif %}</div>
      {%- endif -%}
      <div class="arrows"><button type="button" class="prev" aria-label="Previous reviews"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 9H3M7 4L2.5 9 7 14"/></svg></button><button type="button" class="next" aria-label="Next reviews"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 9h12M11 4l4.5 5-4.5 5"/></svg></button></div>
    </div>
    <div class="track">
      {%- for block in section.blocks -%}
      <figure class="rcard" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 800 }} 800w" sizes="(max-width: 560px) 78vw, 400px" alt="" width="800" height="920" loading="lazy">{%- endif -%}
        <figcaption>
          <div class="row1"><span class="sq" aria-label="{{ block.settings.stars }} stars">{% for s in (1..block.settings.stars) %}<i>★</i>{% endfor %}</span><span class="serif">{{ block.settings.name }}{% if block.settings.label != blank %} <span class="sample">{{ block.settings.label }}</span>{% endif %}</span></div>
          <p class="q clamp">{{ block.settings.text }}</p>
          {%- if block.settings.text.size > 110 -%}
          <button type="button" class="more rm" style="font-size:14px;margin-top:6px" aria-expanded="false" data-more="{{ section.settings.more_label | escape }}" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label }}</button>
          {%- endif -%}
        </figcaption>
      </figure>
      {%- endfor -%}
    </div>
    <div class="progress"><i></i></div>
  </div>
</section>
{% schema %}
{
  "name": "Retra-Shots reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading line 1 (muted)" },
    { "type": "text", "id": "heading_2", "label": "Heading line 2", "default": "Reviews" },
    { "type": "inline_richtext", "id": "rating_text", "label": "Rating line" },
    { "type": "text", "id": "sample_note", "label": "Label after rating line", "info": "Optional small tag after the rating line." },
    { "type": "text", "id": "more_label", "label": "Read more label", "default": "Read more" },
    { "type": "text", "id": "less_label", "label": "Read less label", "default": "Read less" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Customer" },
      { "type": "text", "id": "label", "label": "Tag after name", "info": "Optional small tag after the name." },
      { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Review" }
    ] }
  ],
  "presets": [ { "name": "Retra-Shots reviews" } ]
}
{% endschema %}
