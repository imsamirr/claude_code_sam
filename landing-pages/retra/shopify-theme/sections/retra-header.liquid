{%- style -%}
.bar { position: relative; isolation: isolate; overflow: hidden; background: #0b1622 var(--bar-m) center / cover; color: #fff; }
.bar::before { content: ""; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse 60% 160% at 50% 50%, rgba(0,0,0,.5), rgba(0,0,0,.15)); pointer-events: none; }
.bar-in { display: flex; max-width: 1440px; min-height: 40px; margin: 0 auto; align-items: center; justify-content: center; padding: 8px 16px; }
.bar-copy { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 12px; text-align: center; }
.bar-title { font-family: var(--f-display); font-size: 15px; line-height: 18px; letter-spacing: -.01em; color: #fff; white-space: nowrap; }
.bar-offer { display: inline-flex; flex: none; border-radius: 2px; padding: 1px 5px; background: #f9f7f2; box-shadow: 0 1px 2px rgba(0,0,0,.2); color: #022b49; font-size: 12px; font-weight: 700; letter-spacing: .02em; line-height: 16px; text-transform: uppercase; white-space: nowrap; }
@media (min-width: 1000px) {
  .bar { background-image: var(--bar-d); }
  .bar-in { min-height: 44px; padding-block: 0; }
  .bar-copy { gap: 16px; }
  .bar-title { font-size: 16px; }
  .bar-offer { padding: 2px 6px; font-size: 13px; }
}
{%- endstyle -%}
{%- if section.settings.show_bar -%}
{%- liquid
  if section.settings.bar_bg_desktop
    assign bg_d = section.settings.bar_bg_desktop | image_url: width: 2400
  else
    assign bg_d = 'retra-bar-desktop.jpg' | file_img_url: '2400x'
  endif
  if section.settings.bar_bg_mobile
    assign bg_m = section.settings.bar_bg_mobile | image_url: width: 1200
  else
    assign bg_m = 'retra-bar-mobile.jpg' | file_img_url: '1200x'
  endif
-%}
<div class="bar" role="region" aria-label="{{ section.settings.bar_aria | escape }}" style="--bar-d:url('{{ bg_d }}');--bar-m:url('{{ bg_m }}')">
  <div class="bar-in">
    <span class="bar-copy">
      {%- if section.settings.bar_lead != blank %}<span class="bar-title">{{ section.settings.bar_lead }}</span>{% endif -%}
      {%- if section.settings.offer_tag != blank %}<span class="bar-offer">{{ section.settings.offer_tag }}</span>{% endif -%}
    </span>
  </div>
</div>
{%- endif -%}

<header class="nav">
  <div class="wrap">
    <button class="menu-btn" type="button" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
    <nav aria-label="Main" id="main-nav">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#buy' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </nav>
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.logo_text }}</a>
    <div class="tools">
      {%- if section.settings.support_label != blank -%}
        <a class="txt" href="{{ section.settings.support_link | default: '/pages/contact' }}">{{ section.settings.support_label }}</a>
      {%- endif -%}
      <a href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg></a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3.2"/><path d="M6.5 18.5c1.5-2.3 3.4-3.3 5.5-3.3s4 1 5.5 3.3"/></svg></a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" data-open-cart aria-label="Cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 7h14l-1 13H6L5 7z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/></svg><span class="cart-n" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Retra-Shots header",
  "class": "retra-header",
  "settings": [
    { "type": "header", "content": "Announcement bar" },
    { "type": "checkbox", "id": "show_bar", "label": "Show announcement bar", "default": true },
    { "type": "text", "id": "bar_lead", "label": "Title (serif)", "default": "Black Friday Sale" },
    { "type": "text", "id": "offer_tag", "label": "Offer tag", "default": "BUY 2, GET 1 FREE" },
    { "type": "text", "id": "bar_aria", "label": "Screen-reader label", "default": "Offer" },
    { "type": "image_picker", "id": "bar_bg_desktop", "label": "Background (desktop)", "info": "Empty uses the satin texture file retra-bar-desktop.jpg." },
    { "type": "image_picker", "id": "bar_bg_mobile", "label": "Background (mobile)", "info": "Empty uses retra-bar-mobile.jpg." },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Retra-Shots" },
    { "type": "text", "id": "support_label", "label": "Support link label", "default": "Support" },
    { "type": "text", "id": "support_link", "label": "Support link", "default": "/pages/contact" }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Menu link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Home" },
        { "type": "text", "id": "link", "label": "Link (URL or #section)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "nav_link", "settings": { "label": "Home", "link": "/" } },
      { "type": "nav_link", "settings": { "label": "Shop All", "link": "/products/retra-screen-free-camera" } },
      { "type": "nav_link", "settings": { "label": "Our Story", "link": "#how" } },
      { "type": "nav_link", "settings": { "label": "Track Your Order", "link": "/pages/track-order" } }
    ]
  }
}
{% endschema %}
