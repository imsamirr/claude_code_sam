<section class="sec" id="looks" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="fl-{{ section.id }}">
  <div class="wrap">
    <div class="head">
      {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
      <h2 id="fl-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_2 != blank %}<span class="l2">{{ section.settings.heading_2 }}</span>{% endif %}</h2>
    </div>
    <div class="looks">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 700 }}" srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w" sizes="(max-width: 960px) 50vw, 25vw" alt="{{ block.settings.image.alt | escape }}" width="700" height="700" loading="lazy">{%- endif -%}<figcaption>{{ block.settings.label }}</figcaption></figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank %}<div class="center"><a class="cta" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label }}</a></div>{% endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Retra photo row",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four classic looks," },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (muted)" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#buy" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [ { "type": "item", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "label", "label": "Caption", "default": "Natural" } ] } ],
  "presets": [ { "name": "Retra photo row" } ]
}
{% endschema %}
