<section class="sec" id="how" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="hw-{{ section.id }}">
  <div class="wrap">
    <div class="head">
      {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
      <h2 id="hw-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_2 != blank %}<span class="l2">{{ section.settings.heading_2 }}</span>{% endif %}</h2>
    </div>
    <ol class="how">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><span class="n">{{ forloop.index }}</span><div class="art">{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" width="600" height="450" loading="lazy">{%- endif -%}</div><div class="lbl"><h3>{{ block.settings.title }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}</div></li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Retra-Shots how it works",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four simple steps," },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (muted)" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [ { "type": "step", "name": "Step", "settings": [ { "type": "image_picker", "id": "image", "label": "Illustration" }, { "type": "text", "id": "title", "label": "Title", "default": "Turn on" }, { "type": "text", "id": "text", "label": "Text" } ] } ],
  "presets": [ { "name": "Retra-Shots how it works" } ]
}
{% endschema %}
