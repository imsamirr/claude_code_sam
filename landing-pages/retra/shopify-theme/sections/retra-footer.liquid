<footer id="footer">
  <div class="wrap">
    <div class="f-top"><span class="logo">{{ section.settings.logo_text }}</span>
      {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{%- endif -%}
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" {% if section.settings.instagram != blank %}aria-hidden="true"{% else %}aria-label="Instagram"{% endif %}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#fff"/></svg>
      {%- if section.settings.instagram != blank -%}</a>{%- endif -%}
    </div>
    <div class="f-cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><p class="serif">{{ block.settings.heading }}</p>{{ block.settings.links }}</div>
      {%- endfor -%}
      <div><p class="serif">{{ section.settings.news_heading }}</p>{% if section.settings.news_text != blank %}<p>{{ section.settings.news_text }}</p>{% endif %}
        {%- form 'customer', id: 'retra-news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,retra">
          <div class="news">
            <label for="news-email" class="vh">Email</label>
            <input id="news-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.news_placeholder | escape }}">
            <button type="submit" aria-label="Subscribe"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg></button>
          </div>
          <p class="news-msg" role="status">{% if form.posted_successfully? %}{{ section.settings.news_success }}{% elsif form.errors %}{{ section.settings.news_error }}{% endif %}</p>
        {%- endform -%}
      </div>
    </div>
    <div class="f-bottom"><span>Copyright © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name }}. All rights reserved.</span></div>
  </div>
</footer>
{% schema %}
{
  "name": "Retra footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Retra" },
    { "type": "text", "id": "instagram", "label": "Instagram link" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "news_heading", "label": "Heading", "default": "The Field Journal" },
    { "type": "textarea", "id": "news_text", "label": "Text", "default": "Subscribe for unscripted travel stories, camera tips, and upcoming batch releases." },
    { "type": "text", "id": "news_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "news_success", "label": "Success message", "default": "Welcome to the Field Journal. We will be in touch with our next dispatch." },
    { "type": "text", "id": "news_error", "label": "Error message", "default": "Please enter a valid email address and try again." },
    { "type": "header", "content": "Bottom line" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Retra" }
  ],
  "blocks": [ { "type": "column", "name": "Link column", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" }, { "type": "richtext", "id": "links", "label": "Links (bulleted list)" } ] } ],
  "default": {
    "blocks": [
      { "type": "column", "settings": { "heading": "Customer Support", "links": "<ul><li><a href=\"/pages/track-order\">Studio Dispatch &amp; Tracking</a></li><li><a href=\"/policies/refund-policy\">30-Day Field Trial Policy</a></li><li><a href=\"#faq\">Lightning iPhone Guide</a></li><li><a href=\"/pages/contact\">Contact Us</a></li></ul>" } },
      { "type": "column", "settings": { "heading": "Explore", "links": "<ul><li><a href=\"/products/retra-screen-free-camera\">The Retra Camera</a></li><li><a href=\"#looks\">4 Film Filters</a></li><li><a href=\"#reviews\">Reviews</a></li></ul>" } },
      { "type": "column", "settings": { "heading": "Legal", "links": "<ul><li><a href=\"/policies/privacy-policy\">Privacy Policy</a></li><li><a href=\"/policies/terms-of-service\">Terms of Service</a></li><li><a href=\"/policies/refund-policy\">Refund Policy</a></li></ul>" } }
    ]
  }
}
{% endschema %}
