{%- capture yes %}<span class="yes" aria-label="Yes">✓</span>{% endcapture -%}
{%- capture no %}<span class="no" aria-label="No">✕</span>{% endcapture -%}
{%- capture low %}<span class="dots" aria-label="Low ongoing cost"><i class="f"></i><i></i><i></i></span>{% endcapture -%}
{%- capture mid %}<span class="dots" aria-label="Medium ongoing cost"><i class="f"></i><i class="f"></i><i></i></span>{% endcapture -%}
{%- capture high %}<span class="dots" aria-label="High ongoing cost"><i class="f"></i><i class="f"></i><i class="f"></i></span>{% endcapture -%}
<section class="sec" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="cmp-{{ section.id }}">
  <div class="wrap">
    <div class="head">
      {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
      <h2 id="cmp-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_2 != blank %}<span class="l2">{{ section.settings.heading_2 }}</span>{% endif %}</h2>
      {%- if section.settings.text != blank %}<p class="para">{{ section.settings.text }}</p>{% endif -%}
    </div>
    <div class="cmp-wrap">
      <table class="cmp">
        <thead><tr><th scope="col"><span class="vh">{{ section.settings.feature_label }}</span></th>
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign img = section.settings.img_1
                  assign name = section.settings.name_1
                  assign cls = 'c-us'
                when 2
                  assign img = section.settings.img_2
                  assign name = section.settings.name_2
                  assign cls = 'c-tint'
                else
                  assign img = section.settings.img_3
                  assign name = section.settings.name_3
                  assign cls = 'c-tint'
              endcase
            -%}
            <th scope="col" class="{{ cls }}"><div class="colhead">{%- if img -%}<img src="{{ img | image_url: width: 240 }}" alt="" width="120" height="84" loading="lazy">{%- endif -%}<span class="serif">{{ name }}</span></div></th>
          {%- endfor -%}
        </tr></thead>
        <tbody>
          {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th>
            {%- for i in (1..3) -%}
              {%- liquid
                case i
                  when 1
                    assign val = block.settings.col_1
                    assign cls = 'c-us'
                  when 2
                    assign val = block.settings.col_2
                    assign cls = 'c-tint'
                  else
                    assign val = block.settings.col_3
                    assign cls = 'c-tint'
                endcase
              -%}
              <td class="{{ cls }}">{% case val %}{% when 'yes' %}{{ yes }}{% when 'no' %}{{ no }}{% when 'low' %}{{ low }}{% when 'mid' %}{{ mid }}{% when 'high' %}{{ high }}{% endcase %}</td>
            {%- endfor -%}
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Retra-Shots comparison",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The magic of film," },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (muted)" },
    { "type": "textarea", "id": "text", "label": "Paragraph" },
    { "type": "text", "id": "feature_label", "label": "First column label (screen readers)", "default": "Feature" },
    { "type": "image_picker", "id": "img_1", "label": "Column 1 image" },
    { "type": "text", "id": "name_1", "label": "Column 1 name", "default": "Retra-Shots" },
    { "type": "image_picker", "id": "img_2", "label": "Column 2 image" },
    { "type": "text", "id": "name_2", "label": "Column 2 name", "default": "Disposable" },
    { "type": "image_picker", "id": "img_3", "label": "Column 3 image" },
    { "type": "text", "id": "name_3", "label": "Column 3 name", "default": "Phone Camera" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Feature", "default": "Screen & distraction free" },
      { "type": "select", "id": "col_1", "label": "Column 1", "default": "yes", "options": [ { "value": "yes", "label": "Tick" }, { "value": "no", "label": "Cross" }, { "value": "low", "label": "Low cost (1 dot)" }, { "value": "mid", "label": "Medium cost (2 dots)" }, { "value": "high", "label": "High cost (3 dots)" } ] },
      { "type": "select", "id": "col_2", "label": "Column 2", "default": "yes", "options": [ { "value": "yes", "label": "Tick" }, { "value": "no", "label": "Cross" }, { "value": "low", "label": "Low cost (1 dot)" }, { "value": "mid", "label": "Medium cost (2 dots)" }, { "value": "high", "label": "High cost (3 dots)" } ] },
      { "type": "select", "id": "col_3", "label": "Column 3", "default": "no", "options": [ { "value": "yes", "label": "Tick" }, { "value": "no", "label": "Cross" }, { "value": "low", "label": "Low cost (1 dot)" }, { "value": "mid", "label": "Medium cost (2 dots)" }, { "value": "high", "label": "High cost (3 dots)" } ] }
    ] }
  ],
  "presets": [ { "name": "Retra-Shots comparison" } ]
}
{% endschema %}
