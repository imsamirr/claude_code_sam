{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = product
  endif
-%}
{%- if p != blank -%}
{%- liquid
  assign current = p.selected_variant
  if current == blank and section.settings.default_color != blank
    for v in p.variants
      if v.title == section.settings.default_color
        assign current = v
        break
      endif
    endfor
  endif
  if current == blank
    assign current = p.selected_or_first_available_variant
  endif
  assign color_ids = ','
  for v in p.variants
    if v.featured_media
      assign color_ids = color_ids | append: v.featured_media.id | append: ','
    endif
  endfor
  assign hero = current.featured_media | default: p.featured_media
-%}
<section class="wrap pdp" id="buy" aria-label="{{ p.title | escape }}" data-buybox>
  <div class="gallery">
    <div class="stage">
      {%- if hero -%}
        <img src="{{ hero | image_url: width: 1200 }}" srcset="{{ hero | image_url: width: 700 }} 700w, {{ hero | image_url: width: 1000 }} 1000w, {{ hero | image_url: width: 1400 }} 1400w" sizes="(max-width: 960px) 100vw, 55vw" alt="{{ hero.alt | escape }}" width="1400" height="1400" fetchpriority="high">
      {%- endif -%}
      <div class="ctl" style="right:16px"><button type="button" data-prev aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg></button><button type="button" data-next aria-label="Next image"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></button></div>
    </div>
    <div class="thumbs" role="group" aria-label="Product images">
      {%- if hero -%}
        <button type="button" aria-current="true" data-full="{{ hero | image_url: width: 1200 }}" data-srcset="{{ hero | image_url: width: 700 }} 700w, {{ hero | image_url: width: 1000 }} 1000w, {{ hero | image_url: width: 1400 }} 1400w" data-alt="{{ hero.alt | escape }}"><img src="{{ hero | image_url: width: 140 }}" alt="{{ hero.alt | escape }}" width="140" height="140"></button>
      {%- endif -%}
      {%- for m in p.media -%}
        {%- assign key = ',' | append: m.id | append: ',' -%}
        {%- if m.media_type == 'image' -%}{%- unless color_ids contains key -%}
          <button type="button" data-full="{{ m | image_url: width: 1200 }}" data-srcset="{{ m | image_url: width: 700 }} 700w, {{ m | image_url: width: 1000 }} 1000w, {{ m | image_url: width: 1400 }} 1400w" data-alt="{{ m.alt | escape }}"><img src="{{ m | image_url: width: 140 }}" alt="{{ m.alt | escape }}" width="140" height="140" loading="lazy"></button>
        {%- endunless -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="buy">
    {%- if section.settings.rating_text != blank -%}
      <div class="rating"><span class="sq" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span> <span>{{ section.settings.rating_text }}</span></div>
    {%- endif -%}
    <h1>{{ p.title }}</h1>
    {%- assign badge_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'badge' -%}{%- assign badge_count = badge_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if badge_count > 0 -%}
    <ul class="badges">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <li {{ block.shopify_attributes }}>{%- if block.settings.icon -%}<img src="{{ block.settings.icon | image_url: width: 96 }}" alt="" width="38" height="38" loading="lazy">{%- endif -%}{{ block.settings.text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}

    <div id="retra-cta">
      <div class="price-row"><span class="price">{{ current.price | money_without_trailing_zeros }}</span><s>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>{%- if section.settings.offer_pill != blank -%}<span class="save">{{ section.settings.offer_pill }}</span>{%- endif -%}</div>
    </div>
    {%- if section.settings.stock_text != blank -%}<div class="stock"><i aria-hidden="true"></i>{{ section.settings.stock_text }}</div>{%- endif -%}

    {%- unless p.has_only_default_variant -%}
    <fieldset style="border:0;padding:0;margin:0">
      <legend class="step" style="width:100%"><span class="n">1</span>{{ section.settings.color_label }} <span class="aside" data-color-name>{{ current.title }}</span></legend>
      <div class="swatches">
        {%- for v in p.variants -%}
          {%- assign vm = v.featured_media | default: p.featured_media -%}
          <label title="{{ v.title | escape }}"><input type="radio" name="retra-color" value="{{ v.title | escape }}" data-variant="{{ v.id }}" data-full="{{ vm | image_url: width: 1200 }}" data-srcset="{{ vm | image_url: width: 700 }} 700w, {{ vm | image_url: width: 1000 }} 1000w, {{ vm | image_url: width: 1400 }} 1400w" data-thumb="{{ vm | image_url: width: 140 }}" data-alt="{{ vm.alt | escape }}"{% if v.id == current.id %} checked{% endif %}{% unless v.available %} disabled{% endunless %}><img src="{{ vm | image_url: width: 120 }}" alt="{{ v.title | escape }}" width="52" height="52" loading="lazy"></label>
        {%- endfor -%}
      </div>
    </fieldset>
    {%- endunless -%}

    <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8" enctype="multipart/form-data" data-retra-atc data-added="{{ section.settings.added_label | escape }}" data-error="{{ section.settings.error_label | escape }}">
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="id" value="{{ current.id }}">
      <button class="cta full" type="submit" data-sticky-anchor{% unless current.available %} disabled{% endunless %}><span data-label>{{ section.settings.atc_label }}</span> <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 7h14l-1 13H6L5 7z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7M12 11v5M9.5 13.5h5"/></svg></button>
      <p class="form-msg vh" role="status" data-atc-status></p>
    </form>

    {%- if section.settings.pay_image -%}
      <img class="paybar" src="{{ section.settings.pay_image | image_url: width: 1120 }}" alt="{{ section.settings.pay_alt | escape }}" width="560" height="{{ 560 | divided_by: section.settings.pay_image.aspect_ratio | round }}" loading="lazy">
    {%- endif -%}

    {%- if section.settings.returns_note != blank -%}
    <div class="note"><span class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="2"/><path d="M3 9h18M10 14l-2 2 2 2M8 16h6a2 2 0 0 0 0-4h-1"/></svg></span><span>{{ section.settings.returns_note }}</span></div>
    {%- endif -%}

    <div class="acc">
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
        <details {{ block.shopify_attributes }}><summary>
          {%- case block.settings.icon -%}
            {%- when 'camera' -%}<svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="8" width="20" height="13" rx="2"/><circle cx="13" cy="14.5" r="4"/><path d="M9 8l1.5-3h5L17 8"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h12v10H3zM15 11h4.5L23 14.5V18h-8z"/><circle cx="7.5" cy="19.5" r="2"/><circle cx="18.5" cy="19.5" r="2"/></svg>
            {%- when 'question' -%}<svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="13" cy="13" r="11"/><path d="M10 10.2a3 3 0 1 1 4.2 2.8c-.8.4-1.2 1-1.2 1.8V16M13 19v.5"/></svg>
            {%- else -%}<svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="13" cy="13" r="11"/><path d="M13 12v6M13 8v.5"/></svg>
          {%- endcase -%}{{ block.settings.title }}</summary>
          <div class="body{% if block.settings.use_description %} desc{% endif %}{% if block.settings.faq_style %} mini-faq{% endif %}">
            {%- if block.settings.use_description -%}{{ p.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
          </div>
        </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.sticky_show -%}
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  {%- if hero -%}<img id="sticky-img" src="{{ hero | image_url: width: 140 }}" alt="" width="48" height="48" loading="lazy">{%- endif -%}
  <div><b>{{ p.title }}</b><span>{{ current.price | money_without_trailing_zeros }}{% if section.settings.sticky_sub != blank %} · {{ section.settings.sticky_sub }}{% endif %}</span></div>
  <a class="cta" href="#retra-cta" tabindex="-1">{{ section.settings.sticky_label }}</a>
</div>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p.title | json }},
  "url": {{ request.origin | append: p.url | json }},
  {%- if p.featured_image %}"image": [{{ p.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  "description": {{ p.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ p.vendor | json }} },
  "offers": [
    {%- for v in p.variants -%}
    {
      "@type": "Offer",
      "name": {{ v.title | json }},
      "sku": {{ v.sku | json }},
      "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ request.origin | append: v.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Retra buy box",
  "tag": "div",
  "class": "retra-buybox",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Leave empty on the product page to use that page's product." },
    { "type": "text", "id": "default_color", "label": "Colour selected by default", "default": "Aegean" },
    { "type": "inline_richtext", "id": "rating_text", "label": "Rating line" },
    { "type": "text", "id": "offer_pill", "label": "Offer pill next to price" },
    { "type": "text", "id": "stock_text", "label": "Stock line" },
    { "type": "text", "id": "color_label", "label": "Colour step label", "default": "Choose your color:" },
    { "type": "text", "id": "atc_label", "label": "Add to cart button", "default": "Add to Cart" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to Cart ✓" },
    { "type": "text", "id": "error_label", "label": "Add to cart error", "default": "Could not add to cart. Please check your connection and try again." },
    { "type": "image_picker", "id": "pay_image", "label": "Payment banner" },
    { "type": "text", "id": "pay_alt", "label": "Payment banner alt text" },
    { "type": "inline_richtext", "id": "returns_note", "label": "Returns note" },
    { "type": "header", "content": "Sticky offer bar" },
    { "type": "checkbox", "id": "sticky_show", "label": "Show sticky bar", "default": true },
    { "type": "text", "id": "sticky_sub", "label": "Text after price" },
    { "type": "text", "id": "sticky_label", "label": "Button label (scrolls to the offer)", "default": "Claim BOGO Offer" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Icon badge",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text", "default": "Screen-Free" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Product Details" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "info", "options": [
          { "value": "info", "label": "Info" }, { "value": "camera", "label": "Camera" }, { "value": "truck", "label": "Truck" }, { "value": "question", "label": "Question" } ] },
        { "type": "checkbox", "id": "use_description", "label": "Show the product description", "default": false },
        { "type": "checkbox", "id": "faq_style", "label": "FAQ style (bold lines are questions)", "default": false },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [ { "name": "Retra buy box" } ]
}
{% endschema %}
