<section class="sec" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="why-{{ section.id }}">
  <div class="wrap">
    <div class="head">
      {%- if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif -%}
      <h2 id="why-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_2 != blank %}<span class="l2">{{ section.settings.heading_2 }}</span>{% endif %}</h2>
    </div>
    <div class="why">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 280 }}" alt="" width="140" height="140" loading="lazy">{%- endif -%}<figcaption>{{ block.settings.label }}</figcaption></figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Retra icon row",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Retra works." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (muted)" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [ { "type": "item", "name": "Icon", "settings": [ { "type": "image_picker", "id": "image", "label": "Icon" }, { "type": "text", "id": "label", "label": "Label", "default": "SCREEN-FREE" } ] } ],
  "presets": [ { "name": "Retra icon row" } ]
}
{% endschema %}
