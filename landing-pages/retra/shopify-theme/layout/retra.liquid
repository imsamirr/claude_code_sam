<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#FCFBF9">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- liquid
    assign retra_product = all_products['retra-screen-free-camera']
    if request.page_type == 'index' and retra_product != blank
      assign retra_title = retra_product.title
      assign retra_desc = retra_product.description | strip_html | strip_newlines | truncate: 155
    else
      assign retra_title = page_title
      assign retra_desc = page_description
    endif
  -%}
  <title>{{ retra_title }}{% if current_page != 1 %} – {{ current_page }}{% endif %}</title>
  {%- if retra_desc != blank %}<meta name="description" content="{{ retra_desc | escape }}">{% endif %}
  {%- if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
  <meta property="og:site_name" content="Retra-Shots">
  <meta property="og:title" content="{{ retra_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if retra_desc != blank %}<meta property="og:description" content="{{ retra_desc | escape }}">{% endif %}
  {%- if request.page_type == 'product' %}
    <meta property="og:type" content="product">
    {%- if product.featured_image %}<meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">{% endif %}
  {%- elsif retra_product.featured_image %}
    <meta property="og:type" content="website">
    <meta property="og:image" content="https:{{ retra_product.featured_image | image_url: width: 1200 }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tinos&family=Inter:wght@400;500;600;700&family=Shantell+Sans:ital,wght@1,400&display=swap">
  {{ 'retra.css' | asset_url | stylesheet_tag }}
  <script>window.RetraCart = { moneyFormat: {{ shop.money_format | json }} };</script>
  <script src="{{ 'retra.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="retra">
  <a class="vh" href="#MainContent">Skip to content</a>
  {% section 'retra-header' %}
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
  {% section 'retra-footer' %}
  {% section 'retra-cart-drawer' %}
</body>
</html>
